                  0.074
                ],
                "text": "Held counts the bottles you held on the date you are looking at; Opened shows what you had opened.",
                "trace": null
              },
              {
                "badge": [
                  0.5,
                  0.53
                ],
                "number": 4,
                "target": [
                  0.04,
                  0.62,
                  0.9,
                  0.07
