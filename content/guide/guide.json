      "summary": null,
      "title": "See your cellar through time",
      "tour": {
        "id": "time-lens",
        "message": "Time Lens is the last of the stacked maps: flick up to it, or choose it in the switcher. Then tap a side.",
        "shots": [
          {
            "alt": "Time Lens, with Memories on the left and Evolution on the right.",
            "callouts": [
              {
                "badge": [
                  0.1,
                  0.79
                ],
                "number": 1,
                "target": [
                  0.01,
                  0.298,
                  0.48,
                  0.435
                ],
                "text": "Tap Memories to go back through your cellar's history.",
                "trace": null
              },
              {
                "badge": [
                  0.9,
                  0.79
                ],
                "number": 2,
                "target": [
                  0.51,
                  0.298,
                  0.48,
                  0.435
                ],
                "text": "Tap Evolution to look ahead to how your wines will drink.",
