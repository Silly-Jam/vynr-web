  "chapters": [
    {
      "body": "",
      "group": "getting-around",
      "id": "move",
      "summary": null,
      "title": "Move around vynr",
      "tour": {
        "id": "move",
        "message": "Cellar, Atlas, Storage and Time Lens are maps of your wine, stacked one above the next.",
        "shots": [
          {
            "alt": "Cellar: your wines as a map, grouped by where they come from.",
            "callouts": [
              {
                "badge": [
                  0.86,
                  0.84
                ],
                "number": 1,
                "target": [
                  0.01,
                  0.2,
                  0.98,
                  0.76
                ],
                "text": "Flick up with one finger to go to the next view.",
                "trace": {
                  "fingers": 1,
                  "from": [
                    0.5,
                    0.82
                  ],
                  "hold": false,
                  "motion": "parallel",
                  "to": [
                    0.5,
                    0.45
                  ]
                }
              }
            ],
            "file": "walkthrough-01-cellar.jpg"
          },
          {
            "alt": "Atlas, the wine world your bottles come from, one flick up from Cellar.",
            "callouts": [
              {
                "badge": [
                  0.86,
                  0.45
                ],
                "number": 2,
                "target": [
                  0.01,
                  0.2,
                  0.98,
                  0.76
                ],
                "text": "One flick moves one view: up goes on through Cellar, Atlas, Storage and Time Lens, then round again; down comes back. Storage joins once your bottles are kept in more than one place.",
                "trace": {
                  "fingers": 1,
                  "from": [
                    0.5,
                    0.45
                  ],
                  "hold": false,
                  "motion": "parallel",
                  "to": [
                    0.5,
                    0.82
                  ]
                }
              }
            ],
            "file": "walkthrough-01b-atlas.jpg"
          }
        ],
        "title": "Move around vynr"
      }
    },
    {
      "body": "",
      "group": "getting-around",
      "id": "jump",
      "summary": null,
      "title": "Jump straight to a view",
      "tour": {
        "id": "jump",
        "message": "The switcher lists every view, both lists, Journal and Vynrpedia.",
        "shots": [
          {
            "alt": "The switcher, listing Cellar, Atlas, Storage and Time Lens, the Wine and Producer Lists, Journal and Vynrpedia.",
            "callouts": [
              {
                "badge": [
                  0.9,
                  0.5
                ],
                "number": 1,
                "target": [
                  0.68,
                  0.55,
                  0.3,
                  0.42
                ],
                "text": "Drag up or down with one finger, slow down and hold: the switcher opens under your finger.",
                "trace": {
                  "fingers": 1,
                  "from": [
                    0.82,
                    0.92
                  ],
                  "hold": true,
                  "motion": "parallel",
                  "to": [
                    0.82,
                    0.64
                  ]
                }
              },
              {
                "badge": [
                  0.07,
                  0.4
                ],
                "number": 2,
                "target": [
                  0.12,
                  0.33,
                  0.5,
                  0.645
                ],
                "text": "Keep your finger down, slide onto a view and lift to go there. Lift anywhere else to stay where you are.",
                "trace": null
              },
              {
                "badge": [
                  0.44,
                  0.128
                ],
                "number": 3,
                "target": [
                  0.03,
                  0.09,
                  0.32,
                  0.07
                ],
                "text": "Or tap the name of the view you are in to open the switcher; it stays open, and every row can be tapped.",
                "trace": null
              }
            ],
            "file": "walkthrough-02-switcher.jpg"
          }
        ],
        "title": "Jump straight to a view"
      }
    },
    {
      "body": "",
      "group": "getting-around",
      "id": "two-fingers",
      "summary": null,
      "title": "Two fingers work everywhere",
      "tour": {
        "id": "two-fingers",
        "message": "One finger moves you around wherever it isn't scrolling the page. Two fingers work on every screen, so where one finger scrolls, use two.",
        "shots": [
          {
            "alt": "The Producer List, which scrolls with one finger.",
            "callouts": [
              {
                "badge": [
                  0.88,
                  0.9
                ],
                "number": 1,
                "target": [
                  0.02,
                  0.28,
                  0.96,
                  0.71
                ],
                "text": "Anywhere, drag up or down with two fingers and hold: the same switcher opens. On a list, in Journal or in Vynrpedia, where one finger scrolls, this is how you move.",
                "trace": {
                  "fingers": 2,
                  "from": [
                    0.62,
                    0.92
                  ],
                  "hold": true,
                  "motion": "parallel",
                  "to": [
                    0.62,
                    0.6
                  ]
                }
              }
            ],
            "file": "walkthrough-03-producer-list.jpg"
          },
          {
            "alt": "Vynrpedia, the A to Z of wine words, which also scrolls with one finger.",
            "callouts": [
              {
                "badge": [
                  0.88,
                  0.9
                ],
                "number": 2,
                "target": [
                  0.02,
                  0.28,
                  0.96,
                  0.71
                ],
                "text": "Vynrpedia works the same way: hold with two fingers, then slide onto a view and lift.",
                "trace": {
                  "fingers": 2,
                  "from": [
                    0.62,
                    0.92
                  ],
                  "hold": true,
                  "motion": "parallel",
                  "to": [
                    0.62,
                    0.6
                  ]
                }
              }
            ],
            "file": "walkthrough-03b-vynrpedia.jpg"
          }
        ],
        "title": "Two fingers work everywhere"
      }
    },
    {
      "body": "",
      "group": "getting-around",
      "id": "back-across",
      "summary": null,
      "title": "Go back, and across",
      "tour": {
        "id": "back-across",
        "message": "Sideways swipes work within what you are looking at; they never change the view.",
        "shots": [
          {
            "alt": "A producer's page, opened from the Producer List.",
            "callouts": [
              {
                "badge": [
                  0.07,
                  0.57
                ],
                "number": 1,
                "target": [
                  0.0,
                  0.62,
                  0.1,
                  0.16
                ],
                "text": "Swipe right from the left edge to go back.",
                "trace": {
                  "fingers": 1,
                  "from": [
                    0.05,
                    0.7
                  ],
                  "hold": false,
                  "motion": "parallel",
                  "to": [
                    0.42,
                    0.7
                  ]
                }
              },
              {
                "badge": [
                  0.93,
                  0.2
                ],
                "number": 2,
                "target": [
                  0.1,
                  0.28,
                  0.86,
                  0.35
                ],
                "text": "On a producer opened from a list, swipe left across the page for the next producer, or right for the one before.",
                "trace": {
                  "fingers": 1,
                  "from": [
                    0.88,
                    0.45
                  ],
                  "hold": false,
                  "motion": "parallel",
                  "to": [
                    0.32,
                    0.45
                  ]
                }
              }
            ],
            "file": "walkthrough-04-producer.jpg"
          },
          {
            "alt": "The next producer in the list, one swipe later.",
            "callouts": [
              {
                "badge": [
                  0.25,
                  0.88
                ],
                "number": 3,
                "target": [
                  0.4,
                  0.935,
                  0.2,
                  0.05
                ],
                "text": "The count shows where you are in the list.",
                "trace": null
              }
            ],
            "file": "walkthrough-04b-producer-next.jpg"
          }
        ],
        "title": "Go back, and across"
      }
    },
    {
      "body": "",
      "group": "getting-around",
      "id": "places",
      "summary": null,
      "title": "Into a place, and back out",
      "tour": {
        "id": "places",
        "message": "Cellar and Atlas are maps of places within places: a continent holds its countries, a country its regions. The bar at the bottom shows where you are.",
        "shots": [
          {
            "alt": "Atlas inside France, showing its regions; the bar at the bottom reads Europe, then France.",
            "callouts": [
              {
                "badge": [
                  0.86,
                  0.84
                ],
                "number": 1,
                "target": [
                  0.01,
                  0.19,
                  0.98,
                  0.73
                ],
                "text": "Tap a place on the map to go into it: Europe, then France, then Burgundy.",
                "trace": null
              },
              {
                "badge": [
                  0.085,
                  0.905
                ],
                "number": 2,
                "target": [
                  0.15,
                  0.933,
                  0.145,
                  0.052
                ],
                "text": "The bar at the bottom shows the way in. Tap an earlier place there, such as Europe, to go straight back up to it.",
                "trace": null
              }
            ],
            "file": "walkthrough-04c-atlas-france.jpg"
          },
          {
            "alt": "Atlas one level deeper, inside Burgundy; the bar reads Europe, France, Burgundy.",
            "callouts": [
              {
                "badge": [
                  0.71,
                  0.905
                ],
                "number": 3,
                "target": [
                  0.45,
                  0.933,
                  0.19,
                  0.052
                ],
                "text": "Press and hold a place in the bar, such as Burgundy, to learn about it.",
                "trace": null
              }
            ],
            "file": "walkthrough-04d-atlas-burgundy.jpg"
          },
          {
            "alt": "The panel about Burgundy, opened by pressing and holding Burgundy in the bar, over the map of Burgundy.",
            "callouts": [
              {
                "badge": [
                  0.07,
                  0.19
                ],
                "number": 4,
                "target": [
                  0.0,
                  0.23,
                  0.1,
                  0.16
                ],
                "text": "Swipe right from the left edge to go up one level. Anything open over the map, like this panel, closes first.",
                "trace": {
                  "fingers": 1,
                  "from": [
                    0.05,
                    0.31
                  ],
                  "hold": false,
                  "motion": "parallel",
                  "to": [
                    0.42,
                    0.31
                  ]
                }
              }
            ],
            "file": "walkthrough-04e-atlas-place.jpg"
          },
          {
            "alt": "Atlas at France again, one level up from Burgundy; the bar reads Europe, then France.",
            "callouts": [
              {
                "badge": [
                  0.53,
                  0.96
                ],
                "number": 5,
                "target": [
                  0.15,
                  0.933,
                  0.3,
                  0.052
                ],
                "text": "France again, one level up. Each edge swipe climbs one level; at the top of the map it does nothing.",
                "trace": null
              }
            ],
            "file": "walkthrough-04f-atlas-france-again.jpg"
          }
        ],
        "title": "Into a place, and back out"
      }
    },
    {
      "body": "",
      "group": "getting-around",
      "id": "hold",
      "summary": null,
      "title": "Tap to go there, hold to learn",
      "tour": {
        "id": "hold",
        "message": "Those are the two things a place can do, wherever its name appears. A tap goes there: into a place on the map, or back to an earlier one in the bar. Press and hold — keep your finger still — and vynr tells you what it is instead.",
        "shots": [
          {
            "alt": "Atlas inside Burgundy. The bar at the bottom reads Europe, France, Burgundy, with a finger pressing and holding on Burgundy.",
            "callouts": [
              {
                "badge": [
                  0.71,
                  0.905
                ],
                "number": 1,
                "target": [
                  0.45,
                  0.933,
                  0.19,
                  0.052
                ],
                "text": "Press and hold a place in the bar at the bottom, such as Burgundy, and keep your finger still until it answers.",
                "trace": {
                  "fingers": 1,
                  "from": [
                    0.545,
                    0.959
                  ],
                  "hold": true,
                  "motion": "hold",
                  "to": [
                    0.545,
                    0.959
                  ]
                }
              }
            ],
            "file": "walkthrough-04d-atlas-burgundy.jpg"
          },
          {
            "alt": "The panel that opens over the map after pressing and holding Burgundy, explaining what Burgundy is.",
            "callouts": [
              {
                "badge": [
                  0.5,
                  0.36
                ],
                "number": 2,
                "target": [
                  0.06,
                  0.42,
                  0.88,
                  0.42
                ],
                "text": "The panel explains the place you held — here, what Burgundy is. Every place in the bar at the bottom has one.",
                "trace": null
              },
              {
                "badge": [
                  0.86,
                  0.26
                ],
                "number": 3,
                "target": [
                  0.2,
                  0.3,
                  0.6,
                  0.09
                ],
                "text": "Swipe the panel down to close it. The map is where you left it.",
                "trace": {
                  "fingers": 1,
                  "from": [
                    0.5,
                    0.33
                  ],
                  "hold": false,
                  "motion": "parallel",
                  "to": [
                    0.5,
                    0.6
                  ]
                }
              }
            ],
            "file": "walkthrough-04e-atlas-place.jpg"
          }
        ],
        "title": "Tap to go there, hold to learn"
      }
    },
    {
      "body": "",
      "group": "getting-around",
      "id": "pinch",
      "summary": null,
      "title": "From map to list",
      "tour": {
        "id": "pinch",
        "message": "In Cellar, the map can also be a list of the wines under the place you are in; in Atlas, a list of the producers at or below it. The list follows the bar at the bottom. Storage has no list.",
        "shots": [
          {
            "alt": "Cellar as a map, grouped by country.",
            "callouts": [
              {
                "badge": [
                  0.86,
                  0.84
                ],
                "number": 1,
                "target": [
                  0.01,
                  0.2,
                  0.98,
                  0.76
                ],
                "text": "Spread two fingers apart on the map to see it as a list.",
                "trace": {
                  "fingers": 2,
                  "from": [
                    0.5,
                    0.58
                  ],
                  "hold": false,
                  "motion": "spread",
                  "to": [
                    0.7,
                    0.42
                  ]
                }
              }
            ],
            "file": "walkthrough-01-cellar.jpg"
          },
          {
            "alt": "The same cellar as a list, one row per wine.",
            "callouts": [
              {
                "badge": [
                  0.9,
                  0.92
                ],
                "number": 2,
                "target": [
                  0.01,
                  0.33,
                  0.98,
                  0.66
                ],
                "text": "Pinch two fingers together on the list to go back to the map.",
                "trace": {
                  "fingers": 2,
                  "from": [
                    0.76,
                    0.45
                  ],
                  "hold": false,
                  "motion": "pinch",
                  "to": [
                    0.5,
                    0.68
                  ]
                }
              },
              {
                "badge": [
                  0.46,
                  0.19
                ],
                "number": 3,
                "target": [
                  0.03,
                  0.15,
                  0.34,
                  0.08
                ],
                "text": "Or tap the view name and choose Wine List, or Producer List in Atlas; choose Cellar or Atlas to come back.",
                "trace": null
              }
            ],
            "file": "walkthrough-01c-cellar-list.jpg"
          }
        ],
        "title": "From map to list"
      }
    },
    {
